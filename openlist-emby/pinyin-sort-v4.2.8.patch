diff --git a/server/handles/pinyin.go b/server/handles/pinyin.go
new file mode 100644
index 0000000..311947f
--- /dev/null
+++ b/server/handles/pinyin.go
@@ -0,0 +1,180 @@
+package handles
+
+import (
+	"strings"
+	"sync"
+	"unicode"
+
+	"github.com/mozillazg/go-pinyin"
+)
+
+// 拼音首字母排序（pinyin initials sorting）
+//
+// Emby 客户端按 SortName 排序，而 OpenList 在所有 DTO 构造里都写成
+// SortName = Name（原样拷贝）。CJK 字符的码位顺序是「部首+笔画」，不是拼音
+// 顺序，因此中文媒体在这个排序下是乱的；中英混排时所有中文还会排在所有
+// 英文之后（ASCII 码位更小）。
+//
+// 这里把中文标题转成拼音首字母（流浪地球 -> LLDQ）作为 SortName，
+// 客户端无需任何改动即可得到正确的拼音顺序。
+// 同时填充 ForcedSortName：Emby 在排序时优先使用它，而 OpenList 此前
+// 从未赋值过该字段。
+
+var (
+	// pinyinPhrases 修正多音字。go-pinyin 的单字表按「常用读音」排第一，
+	// 例如 重 -> zhòng（重庆会变成 ZQ），长 -> zhǎng（长空会变成 ZK）。
+	// 这些是影音标题里的高频词，短语级覆盖比逐字猜测可靠。
+	pinyinPhrases = map[string]string{
+		"重庆":    "chong qing",
+		"重庆森林":  "chong qing sen lin",
+		"银行":    "yin hang",
+		"行长":    "hang zhang",
+		"长大":    "zhang da",
+		"长城":    "chang cheng",
+		"长安":    "chang an",
+		"长空":    "chang kong",
+		"长江":    "chang jiang",
+		"长沙":    "chang sha",
+		"长春":    "chang chun",
+		"音乐":    "yin yue",
+		"快乐":    "kuai le",
+		"乐队":    "yue dui",
+		"乐器":    "yue qi",
+		"乐谱":    "yue pu",
+		"乐章":    "yue zhang",
+		"重新":    "chong xin",
+		"重复":    "chong fu",
+		"重量":    "zhong liang",
+		"重要":    "zhong yao",
+		"行为":    "xing wei",
+		"行业":    "hang ye",
+		"同行":    "tong hang",
+		"人参":    "ren shen",
+		"曾经":    "ceng jing",
+		"姓曾":    "xing zeng",
+	}
+
+	// pinyinInitCache 缓存「标题 -> 首字母」的换算结果。
+	// loadEmbyLibrary 每个请求都会重建整个库，转换只发生一次，但同一个
+	// 系列/专辑会在多次 DTO 构造中重复出现，缓存能省掉重复计算。
+	pinyinInitCache sync.Map // map[string]string
+)
+
+// pinyinArgs 返回用于「首字母」风格的配置。
+func pinyinArgs() pinyin.Args {
+	a := pinyin.NewArgs()
+	a.Style = pinyin.FirstLetter
+	return a
+}
+
+// hasHan 判断字符串是否含汉字。纯 ASCII 标题直接跳过转换，避免无谓开销。
+func hasHan(s string) bool {
+	for _, r := range s {
+		if unicode.Is(unicode.Han, r) {
+			return true
+		}
+	}
+	return false
+}
+
+// hanOnly 去掉标点、空格、数字等非汉字字符，返回连续汉字串。
+// 中文标题常写成「流浪地球2」「流浪地球：上海堡垒」，只取汉字部分做首字母。
+func hanOnly(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if unicode.Is(unicode.Han, r) {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// initialsWithPhrases 先把已知多音字短语替换成占位符，再逐字取拼音首字母。
+// 替换用一个不太可能出现在标题里的私用区字符，避免与原标题冲突。
+func initialsWithPhrases(han string) string {
+	const sentinel = '\uE000'
+	replaced := make([]string, 0, 4) // 保存被替换掉的短语原始文本
+
+	var sb strings.Builder
+	rest := han
+	for rest != "" {
+		matched := false
+		// 最长匹配优先，避免「重庆森林」被「重庆」抢先切分
+		for phrase := range pinyinPhrases {
+			if strings.HasPrefix(rest, phrase) {
+				sb.WriteRune(sentinel)
+				replaced = append(replaced, phrase)
+				rest = rest[len(phrase):]
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			r := []rune(rest)[0]
+			sb.WriteRune(r)
+			rest = rest[len(string(r)):]
+		}
+	}
+
+	a := pinyinArgs()
+	var out strings.Builder
+	idx := 0
+	for _, r := range sb.String() {
+		if r == sentinel {
+			// 用短语的拼音首字母替代
+			py := strings.Fields(pinyinPhrases[replaced[idx]])
+			for _, p := range py {
+				if p != "" {
+					out.WriteString(strings.ToUpper(p[:1]))
+				}
+			}
+			idx++
+			continue
+		}
+		// 单字：取首选读音的首字母
+		if py := pinyin.LazyPinyin(string(r), a); len(py) > 0 && py[0] != "" {
+			out.WriteString(strings.ToUpper(py[0]))
+		}
+	}
+	return out.String()
+}
+
+// embySortName 返回用于排序的名字。非中文标题原样返回（保持与 Emby 原行为一致）。
+//
+// 规则：
+//   - 纯 ASCII/数字标题 -> 原样返回
+//   - 含汉字的标题       -> 汉字部分转拼音首字母，ASCII 部分保留原样
+//     例如 "流浪地球" -> "LLDQ"、"Dune 沙丘" -> "DUNE 沙丘" 的汉字部分
+func embySortName(name string) string {
+	name = strings.TrimSpace(name)
+	if name == "" || !hasHan(name) {
+		return name
+	}
+
+	han := hanOnly(name)
+	initials := initialsWithPhrases(han)
+	if initials == "" {
+		return name
+	}
+
+	// 中英混排（如 "Dune 沙丘"）：保留英文前缀，避免把英文标题也变成拼音
+	if prefix := strings.TrimSpace(strings.TrimRightFunc(name, func(r rune) bool {
+		return unicode.Is(unicode.Han, r) || unicode.IsSpace(r) || unicode.IsPunct(r) || unicode.IsNumber(r)
+	})); prefix != "" && !hasHan(prefix) {
+		return strings.ToUpper(prefix) + " " + initials
+	}
+	return initials
+}
+
+// pinyinSortName 带缓存的 embySortName，供 DTO 构造调用。
+func pinyinSortName(name string) string {
+	if !hasHan(name) {
+		return name
+	}
+	if v, ok := pinyinInitCache.Load(name); ok {
+		return v.(string)
+	}
+	v := embySortName(name)
+	pinyinInitCache.Store(name, v)
+	return v
+}
diff --git a/server/handles/pinyin_test.go b/server/handles/pinyin_test.go
new file mode 100644
index 0000000..8e49bb7
--- /dev/null
+++ b/server/handles/pinyin_test.go
@@ -0,0 +1,103 @@
+package handles
+
+import "testing"
+
+// 拼音首字母排序的回归测试。
+// 多音字断言是重点：go-pinyin 的单字表把「常用读音」排第一，
+// 重庆 -> zhòng（错）、长城 -> zhǎng（错），必须靠 pinyinPhrases 覆盖。
+func TestEmbySortName(t *testing.T) {
+	cases := []struct {
+		in   string
+		want string
+	}{
+		// 基本首字母
+		{"流浪地球", "LLDQ"},
+		{"霸王别姬", "BWBJ"},
+		{"杀手", "SS"},
+		{"让子弹飞", "RZDF"},
+		{"我不是药神", "WBSYS"},
+		{"大话西游", "DHXY"},
+		{"无间道", "WJD"},
+		{"唐人街探案", "TRJTA"},
+		{"战狼", "ZL"},
+		{"长安十二时辰", "CASESC"},
+		{"音乐之声", "YYZS"},
+
+		// 多音字：必须走短语覆盖，不能取单字首选读音
+		{"重庆森林", "CQSL"}, // 不是 ZQSL
+		{"重庆", "CQ"},     // 不是 ZQ
+		{"长城", "CC"},     // 不是 ZC
+		{"长安", "CA"},
+		{"银行", "YH"},
+		{"乐器", "YQ"},  // yue, not le (phrase override)
+
+		// 纯 ASCII：必须原样返回，不能被改写大小写
+		{"Alien", "Alien"},
+		{"Dune", "Dune"},
+		{"Interstellar", "Interstellar"},
+		{"", ""},
+		{"2001 A Space Odyssey", "2001 A Space Odyssey"},
+
+		// 中英混排：英文前缀保留并大写，汉字部分转首字母
+		{"Dune 沙丘", "DUNE SQ"},
+	}
+
+	for _, c := range cases {
+		if got := embySortName(c.in); got != c.want {
+			t.Errorf("embySortName(%q) = %q, want %q", c.in, got, c.want)
+		}
+	}
+}
+
+// 纯 ASCII 输入不应进入缓存 map，避免把整个英文库塞进 memory
+func TestPinyinSortNameSkipsASCII(t *testing.T) {
+	if got := pinyinSortName("Interstellar"); got != "Interstellar" {
+		t.Errorf("got %q, want passthrough", got)
+	}
+	if _, ok := pinyinInitCache.Load("Interstellar"); ok {
+		t.Error("ASCII title should not be cached")
+	}
+}
+
+// 缓存命中后结果必须一致
+func TestPinyinSortNameCache(t *testing.T) {
+	first := pinyinSortName("流浪地球")
+	second := pinyinSortName("流浪地球")
+	if first != second || first != "LLDQ" {
+		t.Errorf("cache mismatch: %q vs %q", first, second)
+	}
+}
+
+// 排序结果：中英混排应按拼音/字母交替排列，而不是所有英文在前
+func TestPinyinSortOrder(t *testing.T) {
+	lib := []string{"流浪地球", "霸王别姬", "Alien", "Dune", "战狼", "重庆森林"}
+	want := []string{"Alien", "霸王别姬", "重庆森林", "Dune", "流浪地球", "战狼"}
+
+	// 简单插入排序，key 用 embySortName 的小写形式（与 sortEmbyItems 一致）
+	got := append([]string(nil), lib...)
+	for i := 1; i < len(got); i++ {
+		for j := i; j > 0; j-- {
+			a := embySortName(got[j-1])
+			b := embySortName(got[j])
+			if toLower(a) <= toLower(b) {
+				break
+			}
+			got[j-1], got[j] = got[j], got[j-1]
+		}
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("order mismatch at %d: got %v want %v", i, got, want)
+		}
+	}
+}
+
+func toLower(s string) string {
+	b := []byte(s)
+	for i := range b {
+		if b[i] >= 'A' && b[i] <= 'Z' {
+			b[i] += 'a' - 'A'
+		}
+	}
+	return string(b)
+}
